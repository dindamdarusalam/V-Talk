# Copy this file to .env.local for local development.
# In Vercel, add these as Project Settings > Environment Variables.

# Local backend:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel production example:
# NEXT_PUBLIC_API_BASE_URL=https://your-vtalk-backend.onrender.com
# NEXT_PUBLIC_SITE_URL=https://your-vtalk-frontend.vercel.app

NEXT_PUBLIC_DEFAULT_TRANSPORT=websocket
